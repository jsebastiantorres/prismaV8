// use prisma-next
// Contract inferred from the live database schema. Edit as needed, then run `prisma contract emit`.

namespace public {
  model Actor {
    actorId    Int         @id(map: "actor_pkey") @default(autoincrement()) @map("actor_id")
    firstName  VarChar(45) @map("first_name")
    lastName   VarChar(45) @map("last_name")
    lastUpdate Timestamp   @default(now()) @map("last_update")
    filmActors FilmActor[]

    @@index([lastName], map: "idx_actor_last_name")
    @@map("actor")
  }

  model Country {
    countryId  Int         @id(map: "country_pkey") @default(autoincrement()) @map("country_id")
    country    VarChar(50)
    lastUpdate Timestamp   @default(now()) @map("last_update")
    cities     City[]

    @@map("country")
  }

  model City {
    cityId     Int         @id(map: "city_pkey") @default(autoincrement()) @map("city_id")
    city       VarChar(50)
    countryId  SmallInt    @map("country_id")
    lastUpdate Timestamp   @default(now()) @map("last_update")
    addresses  Address[]
    country    Country     @relation(fields: [countryId], references: [countryId], map: "fk_city")

    @@index([countryId], map: "idx_fk_country_id")
    @@map("city")
  }

  model Address {
    addressId  Int          @id(map: "address_pkey") @default(autoincrement()) @map("address_id")
    address    VarChar(50)
    address2   VarChar(50)?
    district   VarChar(20)
    cityId     SmallInt     @map("city_id")
    postalCode VarChar(10)? @map("postal_code")
    phone      VarChar(20)
    lastUpdate Timestamp    @default(now()) @map("last_update")
    customers  Customer[]
    staff      Staff[]
    stores     Store[]
    city       City         @relation(fields: [cityId], references: [cityId], map: "fk_address_city")

    @@index([cityId], map: "idx_fk_city_id")
    @@map("address")
  }

  model Category {
    categoryId     Int            @id(map: "category_pkey") @default(autoincrement()) @map("category_id")
    name           VarChar(25)
    lastUpdate     Timestamp      @default(now()) @map("last_update")
    filmCategories FilmCategory[]

    @@map("category")
  }

  model Customer {
    customerId Int          @id(map: "customer_pkey") @default(autoincrement()) @map("customer_id")
    storeId    SmallInt     @map("store_id")
    firstName  VarChar(45)  @map("first_name")
    lastName   VarChar(45)  @map("last_name")
    email      VarChar(50)?
    addressId  SmallInt     @map("address_id")
    activebool Boolean      @default(true)
    createDate Date         @default(dbgenerated("('now'::text)::date")) @map("create_date")
    lastUpdate Timestamp?   @default(now()) @map("last_update")
    active     Int?
    payments   Payment[]
    rentals    Rental[]
    address    Address      @relation(fields: [addressId], references: [addressId], onDelete: Restrict, onUpdate: Cascade, map: "customer_address_id_fkey")

    @@index([addressId], map: "idx_fk_address_id")
    @@index([storeId], map: "idx_fk_store_id")
    @@index([lastName], map: "idx_last_name")
    @@map("customer")
  }

  model Language {
    languageId Int       @id(map: "language_pkey") @default(autoincrement()) @map("language_id")
    name       Char(20)
    lastUpdate Timestamp @default(now()) @map("last_update")
    films      Film[]

    @@map("language")
  }

  model Film {
    filmId          Int                     @id(map: "film_pkey") @default(autoincrement()) @map("film_id")
    title           VarChar(255)
    description     String?
    // releaseYear     Unsupported("year")?    @map("release_year")
    languageId      SmallInt                @map("language_id")
    rentalDuration  SmallInt                @default(3) @map("rental_duration")
    rentalRate      Numeric(4, 2)           @default(4.99) @map("rental_rate")
    length          SmallInt?
    replacementCost Numeric(5, 2)           @default(19.99) @map("replacement_cost")
    rating          pg.enum(MpaaRating)?    @default("G")
    lastUpdate      Timestamp               @default(now()) @map("last_update")
    specialFeatures String[]                @noCheck(elementNotNull) @map("special_features")
    // fulltext        Unsupported("tsvector")
    filmActors      FilmActor[]
    filmCategories  FilmCategory[]
    inventories     Inventory[]
    language        Language                @relation(fields: [languageId], references: [languageId], onDelete: Restrict, onUpdate: Cascade, map: "film_language_id_fkey")

    // @@index([fulltext], map: "film_fulltext_idx", type: "gist")
    @@index([languageId], map: "idx_fk_language_id")
    @@index([title], map: "idx_title")
    @@map("film")
  }

  model FilmActor {
    actorId    SmallInt  @map("actor_id")
    filmId     SmallInt  @map("film_id")
    lastUpdate Timestamp @default(now()) @map("last_update")
    actor      Actor     @relation(fields: [actorId], references: [actorId], onDelete: Restrict, onUpdate: Cascade, map: "film_actor_actor_id_fkey", index: false)
    film       Film      @relation(fields: [filmId], references: [filmId], onDelete: Restrict, onUpdate: Cascade, map: "film_actor_film_id_fkey")

    @@id([actorId, filmId], map: "film_actor_pkey")
    @@index([filmId], map: "idx_fk_film_id")
    @@map("film_actor")
  }

  model FilmCategory {
    filmId     SmallInt  @map("film_id")
    categoryId SmallInt  @map("category_id")
    lastUpdate Timestamp @default(now()) @map("last_update")
    category   Category  @relation(fields: [categoryId], references: [categoryId], onDelete: Restrict, onUpdate: Cascade, map: "film_category_category_id_fkey", index: false)
    film       Film      @relation(fields: [filmId], references: [filmId], onDelete: Restrict, onUpdate: Cascade, map: "film_category_film_id_fkey", index: false)

    @@id([filmId, categoryId], map: "film_category_pkey")
    @@map("film_category")
  }

  model Inventory {
    inventoryId Int       @id(map: "inventory_pkey") @default(autoincrement()) @map("inventory_id")
    filmId      SmallInt  @map("film_id")
    storeId     SmallInt  @map("store_id")
    lastUpdate  Timestamp @default(now()) @map("last_update")
    rentals     Rental[]
    film        Film      @relation(fields: [filmId], references: [filmId], onDelete: Restrict, onUpdate: Cascade, map: "inventory_film_id_fkey", index: false)

    @@index([storeId, filmId], map: "idx_store_id_film_id")
    @@map("inventory")
  }

  model Staff {
    staffId    Int          @id(map: "staff_pkey") @default(autoincrement()) @map("staff_id")
    firstName  VarChar(45)  @map("first_name")
    lastName   VarChar(45)  @map("last_name")
    addressId  SmallInt     @map("address_id")
    email      VarChar(50)?
    storeId    SmallInt     @map("store_id")
    active     Boolean      @default(true)
    username   VarChar(16)
    password   VarChar(40)?
    lastUpdate Timestamp    @default(now()) @map("last_update")
    picture    Bytes?
    payments   Payment[]
    rentals    Rental[]
    store      Store[]
    address    Address      @relation(fields: [addressId], references: [addressId], onDelete: Restrict, onUpdate: Cascade, map: "staff_address_id_fkey", index: false)

    @@map("staff")
  }

  model Rental {
    rentalId    Int        @id(map: "rental_pkey") @default(autoincrement()) @map("rental_id")
    rentalDate  Timestamp  @map("rental_date")
    inventoryId Int        @map("inventory_id")
    customerId  SmallInt   @map("customer_id")
    returnDate  Timestamp? @map("return_date")
    staffId     SmallInt   @map("staff_id")
    lastUpdate  Timestamp  @default(now()) @map("last_update")
    payments    Payment[]
    customer    Customer   @relation(fields: [customerId], references: [customerId], onDelete: Restrict, onUpdate: Cascade, map: "rental_customer_id_fkey", index: false)
    inventory   Inventory  @relation(fields: [inventoryId], references: [inventoryId], onDelete: Restrict, onUpdate: Cascade, map: "rental_inventory_id_fkey")
    staff       Staff      @relation(fields: [staffId], references: [staffId], map: "rental_staff_id_key", index: false)

    @@index([inventoryId], map: "idx_fk_inventory_id")
    @@index([rentalDate, inventoryId, customerId], map: "idx_unq_rental_rental_date_inventory_id_customer_id", unique: true)
    @@map("rental")
  }

  model Payment {
    paymentId   Int           @id(map: "payment_pkey") @default(autoincrement()) @map("payment_id")
    customerId  SmallInt      @map("customer_id")
    staffId     SmallInt      @map("staff_id")
    rentalId    Int           @map("rental_id")
    amount      Numeric(5, 2)
    paymentDate Timestamp     @map("payment_date")
    customer    Customer      @relation(fields: [customerId], references: [customerId], onDelete: Restrict, onUpdate: Cascade, map: "payment_customer_id_fkey")
    rental      Rental        @relation(fields: [rentalId], references: [rentalId], onDelete: Restrict, onUpdate: Cascade, map: "payment_rental_id_fkey")
    staff       Staff         @relation(fields: [staffId], references: [staffId], onDelete: Restrict, onUpdate: Cascade, map: "payment_staff_id_fkey")

    @@index([customerId], map: "idx_fk_customer_id")
    @@index([rentalId], map: "idx_fk_rental_id")
    @@index([staffId], map: "idx_fk_staff_id")
    @@map("payment")
  }

  model Perfil {
    perfilId      Int         @id(map: "perfil_pkey") @default(autoincrement()) @map("perfil_id")
    nombre        VarChar(25)
    descripcion   VarChar(50) @unique(map: "perfil_descripcion_key")
    fechaRegistro Timestamp?  @default(now()) @map("fecha_registro")
    usuarios      Usuario[]

    @@map("perfil")
  }

  model Review {
    reviewId   Int        @id(map: "review_pkey") @default(autoincrement()) @map("review_id")
    filmId     Int?       @map("film_id")
    customerId Int?       @map("customer_id")
    rating     Int?
    reviewText String?    @map("review_text")
    reviewDate Timestamp? @default(now()) @map("review_date")

    @@check(expression: "((rating >= 1) AND (rating <= 5))", map: "review_rating_check")
    @@map("review")
  }

  model Store {
    storeId        Int       @id(map: "store_pkey") @default(autoincrement()) @map("store_id")
    managerStaffId SmallInt  @map("manager_staff_id")
    addressId      SmallInt  @map("address_id")
    lastUpdate     Timestamp @default(now()) @map("last_update")
    address        Address   @relation(fields: [addressId], references: [addressId], onDelete: Restrict, onUpdate: Cascade, map: "store_address_id_fkey", index: false)
    managerStaff   Staff     @relation(fields: [managerStaffId], references: [staffId], onDelete: Restrict, onUpdate: Cascade, map: "store_manager_staff_id_fkey")

    @@index([managerStaffId], map: "idx_unq_manager_staff_id", unique: true)
    @@map("store")
  }

  model Usuario {
    usuarioId     Int         @id(map: "usuario_pkey") @default(autoincrement()) @map("usuario_id")
    nombre        VarChar(50)
    usuario       VarChar(15) @unique(map: "usuario_usuario_key")
    fechaRegistro Timestamp?  @default(now()) @map("fecha_registro")
    perfilId      Int?        @map("perfil_id")
    perfil        Perfil?     @relation(fields: [perfilId], references: [perfilId], map: "fk_perfil", index: false)

    @@map("usuario")
  }

   
  native_enum MpaaRating {
    G = "G"
    PG = "PG"
    pG13 = "PG-13"
    R = "R"
    nC17 = "NC-17"
    @@map("mpaa_rating")
  }
}
